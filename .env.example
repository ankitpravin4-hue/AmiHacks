# ShopAPI (packages/vulnerable-api)
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./data/shop.db

# Scanner — never scan hosts not listed here
ALLOWLIST=http://127.0.0.1:8000
SAFE_MODE=true

# Dashboard (optional). Leave empty to use the Vite proxy to :8100
# VITE_API_BASE=http://127.0.0.1:8100
# VITE_WS_BASE=ws://127.0.0.1:8100

# Optional Gemini layer (on-demand Explain + Ask AI only). Leave unset to stay offline.
# GEMINI_API_KEY=
